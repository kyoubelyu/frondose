{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frondose",
  "version": "0.5.0-alpha.26",
  "identifier": "com.kyoube.mai",
  "build": {
    "frontendDist": "../ui",
    "devUrl": null,
    "beforeDevCommand": { "script": "npm run build:tauri", "wait": true },
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Frondose",
        "width": 480,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
