# Stray SQLite memory-mode misuse artifacts (a test passing `:memory:foo:` instead of plain `:memory:`
# causes better-sqlite3 to treat it as a real filename — gitignore so it never leaks into the repo).
:memory:*

# P-32 native addon — compiled artifacts; the C source (native/) is the shipped artifact, never the .node binary.
build/
# WIN-2: tests/build/ holds build-script tests (chmod-dist/copy-web-assets) — must NOT be caught by build/ above.
!tests/build/
*.node

