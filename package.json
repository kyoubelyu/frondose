{
  "name": "@kyoube/mai-agent",
  "version": "0.4.28",
  "description": "Single-binary LinkedIn autonomous agent. Vercel AI SDK base + embedded CDP + ICP-as-soul system prompt + ported mai-linkedin primitives. Operator-facing CLI: `mai`. Private package; not for general distribution.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "mai": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "references",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/main.js && npm run build:web",
    "build:web": "esbuild src/web/main.tsx --bundle --minify --jsx=automatic --external:/vendor/* --outfile=dist/web/app.js && tailwindcss -i src/web/style.css -o dist/web/style.css --minify && cp src/web/index.html dist/web/index.html && cp -r src/web/vendor dist/web/vendor",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:live": "tsx --test 'tests/live/**/*.smoke.ts'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@inquirer/core": "^7",
    "@inquirer/prompts": "^7.10.1",
    "ai": "^4.0.0",
    "better-sqlite3": "^12.4.1",
    "chrome-launcher": "^1.1.2",
    "chrome-remote-interface": "0.34.0",
    "commander": "^12.1.0",
    "ssh2": "^1.17.0",
    "undici": "^6.21.0",
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@tailwindcss/cli": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
