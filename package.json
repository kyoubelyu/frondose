{
  "name": "@kyoube/frondose",
  "version": "0.5.26",
  "description": "Frondose — LinkedIn-primary autonomous sales agent (Tauri desktop app). The operator product is the compiled Frondose.app, not this npm package; no npm publication.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "files": [
    "dist",
    "native",
    "binding.gyp",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install": "node -e \"\"",
    "build:overlay-assets": "node --import tsx scripts/gen-overlay-assets.ts",
    "build:default-credentials": "node --import tsx scripts/gen-default-credentials.ts",
    "build": "npm run build:overlay-assets && npm run build:default-credentials && tsc -p tsconfig.json && node scripts/chmod-dist.mjs && npm run build:native && npm run build:tauri-ui && npm run assert-dist",
    "build:native": "node-gyp rebuild || echo '[frondose] cgevent native addon build skipped (Xcode CLT missing) — hardware input mode unavailable; cdp mode unaffected'",
    "build:tauri-ui": "tsc -p src/tauri/ui/tsconfig.json",
    "build:tauri": "npm run build:overlay-assets && npm run build:default-credentials && tsc -p tsconfig.json && node scripts/chmod-dist.mjs && npm run build:tauri-ui",
    "build:tauri:public": "npm run build:overlay-assets && node --import tsx scripts/gen-public-default-credentials.ts && tsc -p tsconfig.json && node scripts/chmod-dist.mjs && npm run build:tauri-ui",
    "build:runtime:public:macos": "bash scripts/build-runtime-macos.sh",
    "build:runtime:public:windows": "node scripts/build-runtime-windows.mjs",
    "build:public:rehearsal": "npm run build:tauri:public && cargo build --release --manifest-path scripts/updater-verifier/Cargo.toml",
    "build:release": "bash scripts/build-release.sh",
    "build:release:win": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "assert-dist": "node --import tsx scripts/assert-dist.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "npm run test:fast",
    "test:fast": "node scripts/test-fast.mjs",
    "test:gate:source": "node --import tsx --test --experimental-test-module-mocks --test-force-exit --test-name-pattern='T-OS.CI.3|T-OS.CI.4|T-SPLIT.2-3' tests/open-source/public-native-release.mock.test.ts tests/open-source/public-release-policy.mock.test.ts",
    "test:gate:release": "node --import tsx --test --experimental-test-module-mocks --test-force-exit --test-name-pattern='T-OS.Release.0|T-OS.Release.1|T-OS.Release.2|T-OS.Release.3|T-OS.Release.4|T-WIN5.PS1.2' tests/open-source/public-native-release.mock.test.ts tests/open-source/public-native-handoff.mock.test.ts tests/open-source/public-release-policy.mock.test.ts",
    "test:integration": "node --import tsx --test --experimental-test-module-mocks --test-force-exit 'tests/cdp/launcher.mock.test.ts' 'tests/cdp/lifecycle.mock.test.ts' 'tests/linkedin/session-pY4.mock.test.ts' 'tests/tauri/button-click-pY2.1.test.ts' 'tests/tauri/button-integ-pY2.1.test.ts' 'tests/tauri/lifecycle-drun1-pY5.test.ts' 'tests/tauri/entry-flow-pY4.mock.test.ts'",
    "test:all": "node --import tsx --test --experimental-test-module-mocks --test-force-exit 'tests/**/*.test.ts'",
    "check:publication": "node --import tsx --test --test-force-exit --test-reporter=tap --experimental-test-module-mocks 'tests/app/sidecarMain.mock.test.ts' 'tests/cli/subcommands/serve/agentTurnManualIso-pAutoIsolate.mock.test.ts' 'tests/cli/subcommands/serve/cron-autorun-exactly-once.mock.test.ts' 'tests/cli/subcommands/serve/cron-autorun-noProgress-faketime.mock.test.ts' 'tests/cli/subcommands/serve/cron-markran-failsafe.mock.test.ts' 'tests/cli/subcommands/serve/cron-maxSteps.mock.test.ts' 'tests/cli/subcommands/serve/cron-noProgress.mock.test.ts' 'tests/cli/subcommands/serve/cron-pAuto13.mock.test.ts' 'tests/cli/subcommands/serve/cronAutoIsolate-pAutoIsolate.mock.test.ts' 'tests/cli/subcommands/serve/cronProgress.mock.test.ts' 'tests/cli/subcommands/serve/ipc-contract.mock.test.ts' 'tests/cli/subcommands/serve/per-turn-mode-fragment.mock.test.ts' 'tests/cli/subcommands/serve/reapKillCappedRun-pAutoL3fix7.mock.test.ts' 'tests/cli/subcommands/serve/reapOrphanIfIdle-pAutoL3fix5.mock.test.ts' 'tests/cli/subcommands/serve/routes-characterization.mock.test.ts' 'tests/cli/subcommands/serve/routes-split-shape.mock.test.ts' 'tests/cli/subcommands/serve/routes/autoStartStop-pAutoIsolate.mock.test.ts' 'tests/cli/subcommands/serve/runOne-assistantPhase-pUiThinkCompact.mock.test.ts' 'tests/cli/subcommands/serve/runOne-autoRunCompleted-pWLC.mock.test.ts' 'tests/cli/subcommands/serve/runOne-identityReload-e2e-pOnboard.mock.test.ts' 'tests/cli/subcommands/serve/runOne-identityReload-pOnboard.mock.test.ts' 'tests/cli/subcommands/serve/runOne-operator-maxSteps.mock.test.ts' 'tests/cli/subcommands/serve/runOne-operator-noProgress-untouched.mock.test.ts' 'tests/cli/subcommands/serve/runOne-reasoning-pThink.mock.test.ts' 'tests/cli/subcommands/serve/runOne-silentHang-pAutoL3fix2.mock.test.ts' 'tests/cli/subcommands/serve/runOne-toolProgress-pAutoL3fix8.mock.test.ts' 'tests/cli/subcommands/serve/runOne-turnHeartbeat-pAutoL3fix4.mock.test.ts' 'tests/cli/subcommands/serve/runOneOverrideMessages-pAutoIsolate.mock.test.ts' 'tests/cli/subcommands/serve/selectSystem.mock.test.ts' 'tests/cli/subcommands/serve/stopIntentTurnOwnership-issueStopIntent.mock.test.ts' 'tests/cli/subcommands/serve/tcp-transport.mock.test.ts' 'tests/cli/subcommands/serve/turn-characterization.mock.test.ts' 'tests/cli/subcommands/serve/turn-split-shape.mock.test.ts' 'tests/app/finalBackend-ownership.mock.test.ts' 'tests/app/telegramChannel-migration.mock.test.ts' 'tests/agent/pi/loopTimeout-pAutoL3fix.mock.test.ts' 'tests/agent/promptFixes.mock.test.ts' 'tests/agent/systemResume.mock.test.ts' 'tests/app/sidecarImportGraph.mock.test.ts' 'tests/auto/phase-auto-16-rls6-cancel.mock.test.ts' 'tests/contract/fren5-overlay-protocol.mock.test.ts' 'tests/contract/serveSkipClosure.mock.test.ts' 'tests/linkedin/scopeResolver.mock.test.ts' 'tests/native-port/shadow-delete-orphan.mock.test.ts' 'tests/overlay/hideResidual-issueOverlayHideResidual.mock.test.ts' 'tests/persistence/mode-p58a.mock.test.ts' 'tests/serve/autoAuthorize.mock.test.ts' 'tests/serve/autoRunSseFrames.mock.test.ts' 'tests/serve/cronAutoRunLifecycle.mock.test.ts' 'tests/serve/passivePromptMagical.mock.test.ts' 'tests/serve/turnStarted.mock.test.ts' 'tests/serve/workflowCancelAutoRun.mock.test.ts' 'tests/tauri/tray-p76.1.mock.test.ts' 'tests/tauri/two-mode-ui-pY2.1.mock.test.ts' 'tests/tauri/ui/assistantAppBindings-pUiThinkCompact.mock.test.ts' 'tests/tauri/updater-ui-p58d1.mock.test.ts' 'tests/tools/browser/connectSurfaceIntegrity-pAuto6.mock.test.ts' 'tests/tools/methodology/qualifyProfile-staleCache.mock.test.ts' 'tests/tools/sales/pAuto7-reaper.mock.test.ts' 'tests/open-source/public-runtime-contract.mock.test.ts' 'tests/open-source/public-rust-updater.mock.test.ts' 'tests/open-source/public-sales-behavior.mock.test.ts' 'tests/open-source/public-meta-contract.mock.test.ts' 'tests/open-source/sales-doctrine-nonregression.mock.test.ts' 'tests/persistence/config-updateDefault.mock.test.ts' 'tests/persistence/secrets.mock.test.ts' 'tests/overlay/bootstrap-pY2.2a.mock.test.ts' 'tests/agent/pi/assistantPhaseText-pUiThinkCompact.mock.test.ts'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.78.1",
    "ai": "^4.0.0",
    "better-sqlite3": "^12.4.1",
    "chrome-launcher": "^1.1.2",
    "chrome-remote-interface": "0.34.0",
    "undici": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@tauri-apps/cli": "^2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "node-addon-api": "^8.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "overrides": {
